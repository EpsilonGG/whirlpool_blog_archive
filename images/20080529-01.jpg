  <script type="text/javascript">
    $(window).bind('load resize', function() {
      var img = $('#photoImage');
      var a = $('#mainPhoto > a');
      var image = new Image();
      image.src = img.attr('src');
      if (!image.src) {
        return;
      }
      a.click(function(e) {
        e.preventDefault();
      });
      a.find('span').remove();
      a.removeAttr('rel');
      if (image.width > img.width() || image.height > img.height()) {
        img.after($('<span>').addClass('scaleBtn'));
        a.attr('rel', 'lightbox');
      }
    });
  </script>

